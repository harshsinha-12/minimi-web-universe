{
  "name": "minimi-web-universe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/memory/worker.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx src/ai/__evals__/eval__runner.ts",
    "check:services": "tsx scripts/check-services.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "eval:judge": "tsx src/ai/__evals__/eval__runner.ts --judge",
    "eval:agent": "tsx src/ai/__evals__/eval__runner.ts --agent"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@pinecone-database/pinecone": "^9.2.0",
    "better-sqlite3": "^12.4.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "htmlparser2": "^12.0.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "luxon": "^3.7.2",
    "next": "^16.4.6",
    "openai": "^7.55.0",
    "pino": "^10.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "redis": "^5.10.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
