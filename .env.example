# Required. Never put a secret in NEXT_PUBLIC_*.
OPENAI_API_KEY=
# A supported Responses + web_search model. Verify access with npm run check:services.
OPENAI_MODEL=gpt-6-astra
MEMORY_MODEL=gpt-5.4-mini
# Optional Redis. SQLite remains authoritative when Redis is unavailable.
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_TLS=false
# Optional local configuration
DATABASE_PATH=.data/minimi.sqlite
AGENT_DEADLINE_MS=90000
MEMORY_IDLE_MS=20000
MEMORY_MAX_WAIT_MS=120000
MEMORY_ENABLED=true

# Offline evaluator. Reuses OPENAI_API_KEY only when explicitly running eval:judge / eval:agent.
JUDGE_MODEL=gpt-5.4-mini
# Composer microphone. This is speech-to-text, not a chat tool, and audio is not stored.
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Optional semantic memory. Disabled until explicitly configured.
# Create a bring-your-own-vector dense index with cosine metric and these dimensions.
PINECONE_ENABLED=false
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
# Use different prefixes for development and production. Never derive owner IDs from requests.
PINECONE_NAMESPACE_PREFIX=minimi-dev
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# fatal, error, warn, info, debug, or trace. Pretty output is used outside Next
# when stdout is a terminal and NODE_ENV is not production. Set LOG_PRETTY=false to force JSON.
LOG_LEVEL=info
